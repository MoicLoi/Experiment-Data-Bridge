package me.moiclathy.edb.web.service

import io.mockk.every
import io.mockk.verify
import io.mockk.impl.annotations.MockK
import io.mockk.junit5.MockKExtension
import me.moiclathy.edb.core.template.model.*
import me.moiclathy.edb.core.template.repository.TemplateRepository
import me.moiclathy.edb.core.template.service.TemplateService
import me.moiclathy.edb.core.template.service.TemplateValidationService
import me.moiclathy.edb.core.template.validation.TemplateValidationResult
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.extension.ExtendWith
import java.time.Instant

@ExtendWith(MockKExtension::class)
class TemplateServiceTest {

    @MockK
    private lateinit var repository: TemplateRepository

    @MockK
    private lateinit var validator: TemplateValidationService

    private lateinit var templateService: TemplateService

    @BeforeEach
    fun setUp() {
        templateService = TemplateService(repository, validator)

        // 默认让 validator 校验通过（根据你 Service 中的 ValidationResult 结构适配）
        // 如果 TemplateValidationResult 的构造参数不同，请自行微调
        every { validator.validate(any()) } returns TemplateValidationResult(valid = true, errors = emptyList())
    }

    /**
     * 测试工厂方法：完美对齐 Template 及其 TemplateMetadata 的必填字段
     */
    private fun createMockTemplate(id: Long? = 1L): Template {
        return Template(
            id = id,
            name = "Test Template",
            description = "Desc",
            type = TemplateType.values().first(),
            visibility = TemplateVisibility.values().first(),
            metadata = TemplateMetadata(
                createdAt = Instant.now(),
                updatedAt = Instant.now(),
                author = "Tester",
                version = 1
            ),
            yaml = "version: 1.0"
        )
    }

    @Test
    fun `should create template successfully`() {
        val mockTemplate = createMockTemplate(id = null)
        every { repository.exists(any()) } returns false
        every { repository.save(any()) } returns mockTemplate

        val result = templateService.create(mockTemplate)

        assertNotNull(result)
        verify(exactly = 1) { repository.save(any()) }
    }

    @Test
    fun `should update template successfully`() {
        val mockTemplate = createMockTemplate(id = 1L)
        every { repository.update(any()) } returns mockTemplate

        val result = templateService.update(mockTemplate)

        assertEquals(mockTemplate.id, result.id)
        verify(exactly = 1) { repository.update(any()) }
    }

    @Test
    fun `should delete template successfully`() {
        every { repository.delete(any()) } returns Unit

        templateService.delete(1L)

        verify(exactly = 1) { repository.delete(1L) }
    }

    @Test
    fun `should load template by id`() {
        val mockTemplate = createMockTemplate(id = 1L)
        every { repository.findById(1L) } returns mockTemplate

        val result = templateService.load(1L)

        assertEquals(1L, result.id)
        verify(exactly = 1) { repository.findById(1L) }
    }

    @Test
    fun `should search templates by query`() {
        val query = TemplateQuery(keyword = "Test")
        every { repository.search(query) } returns emptyList()

        val results = templateService.search(query)

        assertTrue(results.isEmpty())
        verify(exactly = 1) { repository.search(query) }
    }
}