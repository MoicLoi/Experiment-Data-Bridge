### 1. 登录获取 JWT Token (根据你的实际登录接口调整)
# @name login
POST http://localhost:25560/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    // 将获取到的 token 保存到全局变量中
    client.global.set("auth_token", response.body.token);
%}

### 2. 测试导出项目配置 (ID: 2)
GET http://localhost:25560/api/v1/projects/2/configuration/export
Accept: application/x-yaml
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiIsInVzZXJJZCI6MSwicm9sZSI6IkFETUlOIiwiaXNzIjoiZXhwZXJpbWVudC1kYXRhLWJyaWRnZSIsImF1ZCI6ImVkYi1jbGllbnQiLCJpYXQiOjE3ODYwMDk0ODYsImV4cCI6MTc4NjA5NTg4Nn0.YYeqGGCSnRN0pdhYJ7ckcwT8w5XIdao-4e6iLJQTYQU

> {%
    // 验证响应状态码
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    // 验证 Content-Type 响应头
    client.test("Content-Type is application/x-yaml", function() {
        var contentType = response.headers.valueOf("Content-Type");
        client.assert(contentType.includes("application/x-yaml"), "Content-Type mismatch: " + contentType);
    });

    // 验证 Content-Disposition 文件下载头
    client.test("Content-Disposition triggers download with filename", function() {
        var disposition = response.headers.valueOf("Content-Disposition");
        client.assert(disposition && disposition.includes("attachment") && disposition.includes("filename="),
            "Content-Disposition invalid: " + disposition);
    });
%}