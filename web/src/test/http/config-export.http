### 0. 登录获取 Token（根据你实际的登录接口调整）
POST http://localhost:25560/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    // 自动将返回的 token 保存到环境变量中，方便后续请求直接使用
    client.global.set("auth_token", response.body.token);
    client.global.set("test_user_id", response.body.userId);
%}
###
GET http://localhost:25560/api/v1/projects/2/configuration/preview
Authorization: Bearer {{auth_token}}


### 1. 获取当前项目的配置预览 (当前配置，无 commit 参数)
GET http://localhost:25560/api/v1/projects/1/configuration/preview
Authorization: Bearer {{auth_token}}
Accept: application/json



### 2. 获取指定历史版本的配置预览 (带 commit 查询参数)
GET http://localhost:25560/api/v1/projects/1/configuration/preview?commit=0281ccd
Authorization: Bearer {{auth_token}}
Accept: application/json








### --- 分段测试 1：成功导出项目配置 ---
GET http://localhost:25560/api/v1/projects/2/configuration/export
Authorization: Bearer {{auth_token}}

> {%
    // 验证状态码是否为 200
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Expected status 200, got " + response.status);
    });

    // 验证 Content-Type 是否为 yaml
    client.test("Content-Type is YAML", function() {
        client.assert(response.contentType.mimeType === "application/x-yaml", "Expected application/x-yaml");
    });
%}


### --- 分段测试 2：项目不存在（预期 404） ---
GET http://localhost:25560/api/v1/projects/9999/configuration/export
Authorization: Bearer {{auth_token}}

> {%
    client.test("Status is 404", function() {
        client.assert(response.status === 404, "Expected 404 for non-existent project");
    });
%}


### --- 分段测试 3：未登录（无 Authorization 头，预期 401） ---
GET http://localhost:25560/api/v1/projects/1/configuration/export

> {%
    client.test("Status is 401", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}


### --- 分段测试 4：无权限访问的项目（预期 403） ---
# 假设项目 ID 2 是属于其他管理员的，当前用户无权读取
GET http://localhost:25560/api/v1/projects/2/configuration/export
Authorization: Bearer {{auth_token}}

> {%
    client.test("Status is 403", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}