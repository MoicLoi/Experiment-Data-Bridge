root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{java,xml}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html}]
indent_style = space
indent_size = 2

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{jar,png,jpg,jpeg,gif,ico,pdf,xlsx,zip,gz}]
insert_final_newline = false
