{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDB Desktop",
  "version": "0.25.0",
  "identifier": "me.moiclathy.edb.desktop",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Experiment Data Bridge",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "center": true,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:25560" }
  },
  "bundle": {
    "active": false
  }
}
