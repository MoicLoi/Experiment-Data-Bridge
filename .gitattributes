# Normalize text files to LF in the repository, so clones on any OS agree.
* text=auto

# The Gradle wrapper shell script must keep LF or it breaks on Linux/macOS.
gradlew text eol=lf
*.sh text eol=lf

# Windows launchers keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.zip binary
*.gz binary

# Generated files: flagged so GitHub collapses them in diffs and excludes them
# from language statistics, but kept diffable — a lockfile change is exactly the
# kind of thing a reviewer needs to see.
package-lock.json linguist-generated=true
desktop/src-tauri/Cargo.lock linguist-generated=true
desktop/src-tauri/gen/** linguist-generated=true
