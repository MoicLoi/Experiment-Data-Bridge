package me.moiclathy.edb.core.service

import io.mockk.every
import io.mockk.mockk
import io.mockk.verify
import me.moiclathy.edb.core.database.repository.ProjectRepository
import me.moiclathy.edb.core.database.model.Project
import me.moiclathy.edb.core.git.GitCommitInfo
import me.moiclathy.edb.core.git.GitCommitService
import me.moiclathy.edb.core.git.GitHistoryService
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import java.time.Instant

class ProjectConfigurationServiceUnitTest {

    private lateinit var projectRepository: ProjectRepository
    private lateinit var gitCommitService: GitCommitService
    private lateinit var gitHistoryService: GitHistoryService
    private lateinit var configurationService: ProjectConfigurationService

    @BeforeEach
    fun setUp() {
        projectRepository = mockk(relaxed = true)
        gitCommitService = mockk(relaxed = true)
        gitHistoryService = mockk(relaxed = true)

        configurationService = ProjectConfigurationService(
            projectRepository,
            gitCommitService,
            gitHistoryService
        )
    }

    @Test
    fun `saveConfiguration should update database and invoke git commit`() {
        val projectId = 1001
        val author = "TestUser"
        val yamlContent = "version: 1.0"
        val projectName = "Mouse Study"

        val mockProject = mockk<Project>()
        every { mockProject.name } returns projectName
        every { projectRepository.findById(projectId) } returns mockProject
        every { projectRepository.updateConfiguration(projectId, yamlContent) } returns Unit

        // 模拟 GitCommitService 的返回值
        every {
            gitCommitService.commit(projectId, yamlContent, "Update configuration of $projectName", author)
        } returns GitCommitInfo(
            commitId = "mock-commit-id",
            shortCommitId = "mock-id",
            message = "Update configuration of $projectName",
            author = author,
            email = "test@example.com",
            time = Instant.now()
        )

        // 执行保存
        configurationService.saveConfiguration(projectId, yamlContent, author)

        // 验证数据库更新被调用
        verify(exactly = 1) { projectRepository.updateConfiguration(projectId, yamlContent) }

        // 验证 Git 提交服务被正确调用
        verify(exactly = 1) {
            gitCommitService.commit(projectId, yamlContent, "Update configuration of $projectName", author)
        }
    }
}