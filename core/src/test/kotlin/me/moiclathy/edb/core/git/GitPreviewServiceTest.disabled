package me.moiclathy.edb.core.git

import io.mockk.every
import io.mockk.mockk
import me.moiclathy.edb.core.config.preview.ConfigurationPreview
import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Test

class GitPreviewServiceTest {

    private val loader: GitFileLoader = mockk()
    private val service = GitPreviewService(loader)

    @Test
    fun previewShouldLoadCommitYaml() {
        val yaml = "version: 1\nproject:\n  name: test"

        every {
            loader.loadConfig(
                1,
                "abc"
            )
        } returns yaml

        val preview = service.preview(
            1,
            "abc"
        )

        assertEquals(
            yaml,
            preview.yaml
        )
    }
}