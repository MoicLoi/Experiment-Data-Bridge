    @Test
    fun shouldApplyMigrationWhenVersionIsOlder() {
        val reader = mockk<ConfigVersionReader>()
        val validator = mockk<ConfigSchemaValidator>(relaxed = true)
        val migration = mockk<ConfigMigrationManager>()
        val saveService = mockk<ProjectConfigurationService>()

        // 模拟输入的是 V1 版本
        every { reader.readVersion(any()) } returns 0
        // 模拟迁移成功，升级到 V2
        every { migration.migrate(any(), 0) } returns "version: 2\ndata: migrated"

        val commit = GitCommitInfo(
            commitId = "abc",
            shortCommitId = "abc",
            message = "Import configuration into Demo",
            author = "admin",
            time = Instant.now(),
            email = "admin@edb.local"
        )

        every { saveService.saveConfiguration(any(), any(), any(), any(), any()) } returns commit

        val service = ProjectConfigurationImportService(
            validator = validator,
            migrationManager = migration,
            configurationService = saveService,
            versionReader = reader
        )

        val report = service.importConfiguration(
            projectId = 1,
            userId = 1,
            yaml = "version: 1",
            author = "admin"
        )

        assertTrue(report.migrationApplied)
        assertEquals(0, report.originalVersion)
        assertEquals(1, report.migratedVersion) // 假设当前最新版本是 2 (ConfigSchema.CURRENT_VERSION)
    }

    @Test
    fun shouldNotApplyMigrationWhenVersionIsUpToDate() {
        val reader = mockk<ConfigVersionReader>()
        val validator = mockk<ConfigSchemaValidator>(relaxed = true)
        val migration = mockk<ConfigMigrationManager>()
        val saveService = mockk<ProjectConfigurationService>()

        // 模拟输入的是当前最新版本（例如 V2，根据你的 ConfigSchema.CURRENT_VERSION 调整）
        every { reader.readVersion(any()) } returns 1
        // 不需要执行迁移，migration.migrate 不会被调用

        val commit = GitCommitInfo(
            commitId = "def",
            shortCommitId = "def",
            message = "Import configuration into Demo",
            author = "admin",
            time = Instant.now(),
            email = "admin@edb.local"
        )

        every { saveService.saveConfiguration(any(), any(), any(), any(), any()) } returns commit

        val service = ProjectConfigurationImportService(
            validator = validator,
            migrationManager = migration,
            configurationService = saveService,
            versionReader = reader
        )

        val report = service.importConfiguration(
            projectId = 1,
            userId = 1,
            yaml = "version: 2",
            author = "admin"
        )

        assertFalse(report.migrationApplied)
        assertEquals(1, report.originalVersion)
        assertEquals(1, report.migratedVersion)
    }
}