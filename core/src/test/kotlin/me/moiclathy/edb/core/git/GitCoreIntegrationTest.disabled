package me.moiclathy.edb.core.git

import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.io.TempDir
import java.nio.file.Path

class GitCoreIntegrationTest {

    @TempDir
    lateinit var tempDir: Path

    private lateinit var repositoryService: GitRepositoryService
    private lateinit var commitService: GitCommitService
    private lateinit var historyService: GitHistoryService
    private lateinit var fileLoader: GitFileLoader
    private lateinit var diffService: GitDiffService

    @BeforeEach
    fun setUp() {
        // 使用 @TempDir 实现完全沙箱隔离
        repositoryService = GitRepositoryService(customRootDirectory = tempDir)
        commitService = GitCommitService(repositoryService)
        historyService = GitHistoryService(repositoryService)
        fileLoader = GitFileLoader(repositoryService)

        // 修正：正确传入 loader 参数
        diffService = GitDiffService(fileLoader)
    }

    @Test
    fun `should execute full git lifecycle successfully`() {
        val projectId = 4000
        val author = "MasterTestUser"

        // 1. 初始化仓库
        repositoryService.initialize(projectId)
        assertTrue(repositoryService.exists(projectId))

        // 2. 提交第 1 个版本 (Commit)
        val commit1 = commitService.commit(
            projectId = projectId,
            yaml = "version: 1\nsetting: A",
            message = "Initial commit",
            author = author
        )
        assertNotNull(commit1.commitId)

        // 3. 提交第 2 个版本 (Commit)
        val commit2 = commitService.commit(
            projectId = projectId,
            yaml = "version: 2\nsetting: B",
            message = "Second commit",
            author = author
        )
        assertNotNull(commit2.commitId)

        // 4. 验证历史记录 (History)
        val history = historyService.history(projectId)
        assertEquals(2, history.size)
        assertEquals("Second commit", history[0].message)
        assertEquals("Initial commit", history[1].message)
        assertEquals(author, history[0].author)

        // 5. 验证文件加载与版本还原 (Restore / Loader)
        val oldContent = fileLoader.loadConfig(
            projectId,
            commit1.commitId
        )
        assertTrue(
            oldContent.contains("setting: A")
        )

        val newContent = fileLoader.loadConfig(
            projectId,
            commit2.commitId
        )
        assertTrue(
            newContent.contains("setting: B")
        )

        // 6. 验证差异对比 (Diff)
        val diffResult = diffService.diff(
            projectId,
            commit1.commitId,
            commit2.commitId
        )
        assertEquals(
            commit1.commitId,
            diffResult.oldCommit
        )
        assertEquals(
            commit2.commitId,
            diffResult.newCommit
        )
        assertTrue(
            diffResult.oldContent.contains("setting: A")
        )
        assertTrue(
            diffResult.newContent.contains("setting: B")
        )
    }
}